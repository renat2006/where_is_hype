# Копия в .farm/farm.env (не коммитится). Пути без захардкоженного дома: $HOME раскрывается.
ROOT=$HOME/dev/where_is_hype
WORKTREES=.farm/worktrees
BASE_BRANCH=main
REMOTE=github-hype
# Прокси для агентов host:port (HTTP + SOCKS5 на одном порту). auto — 127.0.0.1:2080, если слушает. Пусто — без прокси.
# Gemini API из РФ отвечает «User location is not supported», поэтому agy без прокси не работает.
PROXY=auto
# Каталоги, которые ставятся в начало PATH агентов, проверок и балансера (Node 24 и pnpm, uv).
EXTRA_PATH=$HOME/.local/share/node24/bin:$HOME/.local/bin
# Выполняется в новой рабочей копии один раз. Те же шаги, что в CI (.github/workflows/ci.yml).
SETUP_CMD="pnpm install --frozen-lockfile && cd apps/api && uv sync --locked"
# Гейты verify.sh = проверки CI. Пусто — шаг пропускается с пометкой SKIP. Можно использовать $PORT.
LINT_CMD="pnpm format:check && pnpm lint && pnpm lint:fsd && cd apps/api && uv run ruff check . && uv run ruff format --check ."
TYPECHECK_CMD="pnpm typecheck && cd apps/api && uv run mypy src tests"
TEST_CMD="pnpm test && cd apps/api && uv run pytest"
BUILD_CMD="VITE_API_MOCKS=true pnpm --filter @where-is-hype/web build"
E2E_CMD=
