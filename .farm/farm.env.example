# Копия в .farm/farm.env (не коммитится). Пути без захардкоженного дома: $HOME раскрывается.
ROOT=$HOME/dev/where_is_hype
WORKTREES=.farm/worktrees
BASE_BRANCH=main
REMOTE=github-hype
# Прокси для агентов host:port (HTTP + SOCKS5 на одном порту). auto — 127.0.0.1:2080, если слушает. Пусто — без прокси.
# Gemini API из РФ отвечает «User location is not supported», поэтому agy без прокси не работает.
PROXY=auto
# Выполняется в новой рабочей копии один раз (например: npm ci)
SETUP_CMD=
# Гейты verify.sh. Пусто — шаг пропускается с пометкой SKIP. Можно использовать $PORT.
LINT_CMD=
TYPECHECK_CMD=
TEST_CMD=
BUILD_CMD=
E2E_CMD=
